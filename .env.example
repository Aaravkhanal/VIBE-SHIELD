# Public origin where the dashboard is served. Use HTTPS outside localhost.
APP_URL=http://localhost:3000

# Create an OAuth 2.0 Web application in Google Cloud and register:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google sign-in is automatically required when both credentials are present.
# Set this to true when a deployment must fail closed if credentials are missing.
AUTH_REQUIRED=false

# Settings, API-key rotation, and CI workflow generation are admin-only.
AUTH_ADMIN_EMAILS=you@example.com

# Optional comma-separated allowlist. Leave empty to allow any verified Google account.
AUTH_ALLOWED_EMAILS=
